<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dog_gazebo</name>
  <version>2.0.0</version>
  <description>Gazebo simulation of the robot dog (same locomotion and teleop as the real robot).</description>
  <maintainer email="hzname@example.com">hzname</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>dog_bringup</exec_depend>
  <exec_depend>dog_control</exec_depend>
  <exec_depend>dog_description</exec_depend>
  <exec_depend>dog_teleop</exec_depend>
  <exec_depend>dog_web</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
