<?xml version="1.0"?>
<package format="3">
  <name>dog_perception</name>
  <version>2.0.0</version>
  <description>Terrain perception: crossed (X) single-beam lidars and VL53L1X ToF sensors -
    ground plane, elevation map, obstacle / step detection ahead of the feet.</description>
  <maintainer email="hzname@example.com">hzname</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
