[Unit]
Description=Servo pose page (mount trim, PCA9685 direct, bench tool)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sg
WorkingDirectory=/home/sg
ExecStart=/usr/bin/python3 /home/sg/servo_pose_server.py 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
